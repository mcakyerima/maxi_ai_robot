# Example environment variables for cloud deployment
# Copy this to .env and fill in your actual values

# === API Keys ===
GROQ_API_KEY=your_groq_api_key_here
OPENWEATHER_API_KEY=your_weather_api_key_here

# === Raspberry Pi Configuration ===
RASPBERRY_PI_IP=192.168.1.100
RASPBERRY_PI_PORT=5001

# === Deployment Mode ===
# Set to "cloud" for cloud deployment, "local" for laptop development
DEPLOYMENT_MODE=cloud

# === Robot Configuration ===
USE_WAKE_WORD=false
AUDIO_CAPTURE_MODE=ui
TRANSCRIBER_MODE=groq
LLM_PROVIDER=groq
GROQ_MODEL=compound-beta-mini

# === Audio Settings ===
SAMPLE_RATE=16000
CHANNELS=1

# === Timeouts ===
LISTENING_TIMEOUT_ENABLED=true
DEFAULT_LISTENING_TIMEOUT=20.0
SHORT_LISTENING_TIMEOUT=8.0
WAKE_LISTENING_TIMEOUT=45.0

# === Server Settings (for cloud platforms) ===
PORT=5002
HOST=0.0.0.0
WEBSOCKET_PORT=8765

# === Parental Controls ===
# PIN for accessing parent dashboard (tap robot face 5 times on menu)
# Default: 1234 (CHANGE THIS for production!)
PARENT_DASHBOARD_PIN=1234
